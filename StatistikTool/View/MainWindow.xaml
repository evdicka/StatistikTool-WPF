<Window x:Class="StatistikTool.MainWindow"
        xmlns:vm="clr-namespace:StatistikTool.ViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StatistikTool"
        mc:Ignorable="d"
        Title="Statistik-Tool" Height="450" Width="440" MinHeight="450" MinWidth="440">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Canvas x:Name="myCanvas" Margin="10,226,10,27" Background="LightBlue" SizeChanged="myCanvas_SizeChanged"/>
        <DataGrid x:Name="DataList" ItemsSource="{Binding Datas}" AutoGenerateColumns="False" IsReadOnly="True" Margin="42,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="191" Height="200" SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" />
                <DataGridTextColumn Header="Wert" Binding="{Binding Wert}" />

            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="DeleteButton" Content="Löschen" HorizontalAlignment="Left" Margin="337,59,0,0" VerticalAlignment="Top" Click="DeleteButton_Click" IsEnabled="False"/>
        <Button x:Name="NewButton" Content="Neu" HorizontalAlignment="Left" Margin="337,13,0,0" VerticalAlignment="Top" Width="47" Click="NewButton_Click"/>
    </Grid>
</Window>

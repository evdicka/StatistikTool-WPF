<Window x:Class="StatistikTool.NeuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Daten hinzufügen" Height="340" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="Bezeichnung" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="BezeichnungTextBox" HorizontalAlignment="Left" Margin="110,14,0,0" VerticalAlignment="Top" Width="160" Height="22"/>
        <Label Content="Wert" HorizontalAlignment="Left" Margin="10,44,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="WertTextBox" HorizontalAlignment="Left" Margin="110,48,0,0" VerticalAlignment="Top" Width="160" Height="22"/>

        <Border x:Name="FarbVorschau" Margin="10,85,10,0" VerticalAlignment="Top" Height="50" BorderBrush="Gray" BorderThickness="1"/>

        <Label Content="Rot" HorizontalAlignment="Left" Margin="10,145,0,0" VerticalAlignment="Top"/>
        <Slider x:Name="RotSlider" Minimum="0" Maximum="255" Margin="110,149,10,0" VerticalAlignment="Top" ValueChanged="Slider_ValueChanged"/>
        <Label Content="Grün" HorizontalAlignment="Left" Margin="10,175,0,0" VerticalAlignment="Top"/>
        <Slider x:Name="GruenSlider" Minimum="0" Maximum="255" Margin="110,179,10,0" VerticalAlignment="Top" ValueChanged="Slider_ValueChanged"/>
        <Label Content="Blau" HorizontalAlignment="Left" Margin="10,205,0,0" VerticalAlignment="Top"/>
        <Slider x:Name="BlauSlider" Minimum="0" Maximum="255" Margin="110,209,10,0" VerticalAlignment="Top" ValueChanged="Slider_ValueChanged"/>

        <Button x:Name="AbbrechButton" Content="Abbrechen" HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top" Width="81" Height="30" Click="AbbrechButton_Click"/>
        <Button x:Name="OkButton" Content="Ok" HorizontalAlignment="Right" Margin="0,250,10,0" VerticalAlignment="Top" Width="81" Height="30" IsDefault="True" Click="OkButton_Click"/>
    </Grid>
</Window>
